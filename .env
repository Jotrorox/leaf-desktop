# Public build configuration (nothing secret: a Clerk publishable key is
# meant to ship in clients). Defaults to leaf's production services; put
# overrides in .env.local (git-ignored), e.g. for a local backend:
#   VITE_API_URL=http://localhost:8080
#   VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
#   VITE_WEB_ORIGIN=http://localhost:5173   # the backend's ALLOWED_ORIGIN

# The leaf API.
VITE_API_URL=https://api.leaf.jotrorox.com
# Clerk instance (same as the web app's).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubGVhZi5qb3Ryb3JveC5jb20k
# The web app: shared links point there, legal pages open there, and live
# sync sockets are opened as this origin (the API's ALLOWED_ORIGIN).
VITE_WEB_ORIGIN=https://leaf.jotrorox.com
# Settings → Connected apps (AI assistants through leaf-mcp), as on the web.
VITE_AI_ASSISTANTS=1
