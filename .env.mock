# Loaded by `pnpm dev:mock` (vite --mode mock). Runs the app against the
# in-memory mock backend in src/api/mock/ with a stand-in for Clerk, so no
# backend or Clerk instance is needed. Nothing secret goes here.
VITE_API_MOCK=1
# Average response time in ms (each request takes 50–150% of it).
VITE_API_MOCK_LATENCY=150
# Fail every Nth write (POST, PATCH, DELETE) with a 500, to see rollback. 0: never.
VITE_API_MOCK_FAIL_EVERY=0
